<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/dt_surface"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/dt_outline"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="11dp"
        android:paddingEnd="10dp"
        android:paddingBottom="11dp">

        <CheckBox
            android:id="@+id/taskCheck"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:buttonTint="@color/dt_lime"
            android:contentDescription="@string/start_dictation" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/taskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/dt_paper"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/taskMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/dt_ink_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/dt_magenta"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="@string/remove"
            android:textColor="@color/dt_black"
            android:textSize="11sp"
            app:cornerRadius="0dp"
            app:strokeColor="@color/dt_black"
            app:strokeWidth="2dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

