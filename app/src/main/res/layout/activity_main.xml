<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dt_charcoal">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/capture_status"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12"
                android:paddingStart="9dp"
                android:paddingTop="5dp"
                android:paddingEnd="9dp"
                android:paddingBottom="5dp"
                android:text="@string/top_label"
                android:textColor="@color/dt_paper"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.04"
                    android:lineSpacingExtra="-4dp"
                    android:text="@string/headline_line_one"
                    android:textColor="@color/dt_lime"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/wordmark_tag"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:text="@string/headline_line_two"
                    android:textColor="@color/dt_black"
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/headline_support"
                android:textColor="@color/dt_paper"
                android:textSize="17sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                app:cardBackgroundColor="@color/dt_surface"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dt_outline"
                app:strokeWidth="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:background="@color/dt_magenta" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1"
                            android:text="@string/capture_label"
                            android:textColor="@color/dt_lime"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/capture_title"
                            android:textColor="@color/dt_paper"
                            android:textSize="25sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/capture_body"
                            android:textColor="@color/dt_ink_muted"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/transcriptLayout"
                            style="@style/Widget.Material3.TextInputLayout.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            app:boxBackgroundColor="@color/dt_surface_high"
                            app:boxStrokeColor="@color/dt_teal"
                            app:boxStrokeWidth="3dp"
                            app:boxStrokeWidthFocused="3dp"
                            app:hintTextColor="@color/dt_ink_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/transcriptInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:hint="@string/draft_hint"
                                android:inputType="textCapSentences|textMultiLine"
                                android:minLines="3"
                                android:paddingTop="15dp"
                                android:paddingBottom="15dp"
                                android:textColor="@color/dt_paper"
                                android:textColorHint="@color/dt_ink_muted"
                                android:textSize="17sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/voiceStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:background="@drawable/capture_status"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="1dp"
                            android:paddingStart="10dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="8dp"
                            android:textColor="@color/dt_paper"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dictateButton"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="15dp"
                            android:backgroundTint="@color/dt_lime"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.07"
                            android:text="@string/start_dictation"
                            android:textColor="@color/dt_black"
                            android:textSize="15sp"
                            app:cornerRadius="0dp"
                            app:strokeColor="@color/dt_black"
                            app:strokeWidth="3dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/saveTaskButton"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/dt_orange"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.07"
                                android:text="@string/save_task"
                                android:textColor="@color/dt_black"
                                android:textSize="15sp"
                                app:cornerRadius="0dp"
                                app:strokeColor="@color/dt_black"
                                app:strokeWidth="3dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/clearDraftButton"
                                android:layout_width="wrap_content"
                                android:layout_height="50dp"
                                android:layout_marginStart="9dp"
                                android:backgroundTint="@color/dt_surface_high"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.05"
                                android:text="@string/clear_draft"
                                android:textColor="@color/dt_paper"
                                android:textSize="13sp"
                                app:cornerRadius="0dp"
                                app:strokeColor="@color/dt_paper"
                                app:strokeWidth="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.1"
                        android:text="@string/task_list_label"
                        android:textColor="@color/dt_magenta"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/task_list_title"
                        android:textColor="@color/dt_paper"
                        android:textSize="25sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/taskSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/wordmark_tag"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/dt_black"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/empty_state_frame"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:text="@string/empty_state_body"
                android:textColor="@color/dt_paper"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/taskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

